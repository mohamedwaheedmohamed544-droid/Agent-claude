# ─── Nexus AI environment variables ───────────────────────────────
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.

# Required
DATABASE_URL=                 # Neon PostgreSQL connection string (pooled), sslmode=require
OPENAI_API_KEY=               # OpenAI API key
OPENAI_MODEL=                 # Primary chat model available to your account (e.g. a GPT-4.1/GPT-5 family model)

# Strongly recommended
NEXUS_ENCRYPTION_KEY=         # 32-byte base64 key (openssl rand -base64 32). Encrypts integration tokens. Do not rotate without re-connecting integrations.
CRON_SECRET=                  # Random string. Vercel Cron sends it as a Bearer token to /api/cron/tick.
NEXUS_APP_URL=                # Public base URL, e.g. https://nexus.example.com (used for OAuth redirect URIs)

# Optional model configuration (all must be models your account can access — verify in Analytics → System health)
OPENAI_FALLBACK_MODEL=        # Used automatically when the primary model errors or is unavailable
OPENAI_FAST_MODEL=            # Cheaper model for simple steps (Operations agent, condition checks)
OPENAI_ADVANCED_MODEL=        # Stronger model for Documents/Analytics agents
OPENAI_EMBEDDING_MODEL=       # Default: text-embedding-3-small (1536 dims)
OPENAI_SEARCH_MODEL=          # Model used with the web_search tool (defaults to OPENAI_MODEL)
NEXUS_MODEL_PRICING=          # JSON override for cost estimates: {"model-prefix":[inputUsdPer1M, outputUsdPer1M]}

# Optional integrations (OAuth apps you register; redirect URI = ${NEXUS_APP_URL}/api/integrations/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Optional access control & limits
NEXUS_DISABLE_SIGNUP=         # "1" = only the first account can self-register; add others from Settings → Members
NEXUS_ALLOWED_SIGNUP_DOMAINS= # e.g. "pureminds.com.sa" — restrict self sign-up to these email domains
NEXUS_MAX_UPLOAD_MB=4         # Per-file upload cap (Vercel serverless request bodies are limited to ~4.5 MB)
NEXUS_TASK_BUDGET_MS=240000   # Time a background task runner may work per invocation before yielding
DB_POOL_MAX=5

# Testing only — never set in production
# NEXUS_LLM_PROVIDER=mock
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/nexus_test
